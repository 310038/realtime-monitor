# ==============================================================
#  即時資料分析與監控系統 - 環境變數範例
#  使用方式：cp .env.example .env，並修改密碼與金鑰
# ==============================================================

# ---------- 一般 ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
TZ=Asia/Taipei
# JSON 陣列格式
CORS_ORIGINS=["*"]

# ---------- 對外 Port ----------
BACKEND_PORT=8000
FRONTEND_PORT=8501
DB_EXPOSE_PORT=3306
# 前端側邊欄「API 文件」按鈕使用的瀏覽器可存取網址
PUBLIC_API_URL=http://localhost:8000

# ---------- MariaDB ----------
MARIADB_ROOT_PASSWORD=change_me_root
DB_NAME=monitor
DB_USER=monitor
DB_PASSWORD=change_me_db
# 本機（非 Docker）執行後端時使用；Docker Compose 會覆寫為 db
DB_HOST=localhost
DB_PORT=3306
# SQLAlchemy 連接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------- JWT ----------
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---------- 預設帳號（首次啟動自動建立）----------
SEED_DEFAULT_USERS=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@example.com
DEMO_USER_PASSWORD=User@123
DEMO_VIEWER_PASSWORD=Viewer@123
# 資料表為空時匯入 sample_data/records.csv
SEED_SAMPLE_DATA=true

# ---------- 即時資料產生器 ----------
GENERATOR_ENABLED=true
GENERATOR_INTERVAL_SECONDS=1
REALTIME_METRICS=["temperature","humidity","cpu_usage","pressure"]

# ---------- 批次寫入（定期 / 條件觸發）----------
# 每 N 秒寫入一次
BATCH_FLUSH_INTERVAL_SECONDS=10
# 緩衝區達到 N 筆時立即寫入
BATCH_MAX_SIZE=50
# 出現異常值時立即寫入
FLUSH_ON_ANOMALY=true

# ---------- 告警閾值（初始值，之後可由 Admin 在介面調整）----------
DEFAULT_THRESHOLD=90
THRESHOLDS={"temperature":35,"humidity":85,"cpu_usage":90,"pressure":1030,"sales":5000,"traffic":800}
